version: 2

project_name: {{.Name}}

before:
  hooks:
    - go mod tidy

builds:
  - id: {{.Name}}
    main: ./
    binary: {{.Name}}
    env:
      - CGO_ENABLED=0
    goos: [darwin, linux]
    goarch: [amd64, arm64]
    ldflags:
      - -s -w -X main.version={{`{{.Version}}`}} -X main.commit={{`{{.Commit}}`}} -X main.date={{`{{.Date}}`}}

archives:
  - id: default
    name_template: "{{`{{ .ProjectName }}_{{ .Version }}_{{ .Os }}_{{ .Arch }}`}}"
    formats: [tar.gz]

checksum:
  name_template: "checksums.txt"

changelog:
  sort: asc
  use: github
  filters:
    exclude:
      - "^docs:"
      - "^test:"
      - "^chore:"
      - "Merge pull request"
  groups:
    - title: Features
      regexp: "^.*feat[(\\w)]*:.*$"
      order: 0
    - title: Bug fixes
      regexp: "^.*fix[(\\w)]*:.*$"
      order: 1
    - title: Other
      order: 999

release:
  github:
    owner: {{.Owner}}
    name: {{.Repo}}
  draft: false
  prerelease: auto

# Auto-publish a Formula to jwa91/homebrew-tap on every tag.
# Requires GITHUB_TOKEN with write access to the tap repo.
brews:
  - name: {{.Name}}
    description: "{{.Desc}}"
    homepage: "https://github.com/{{.Owner}}/{{.Repo}}"
    license: MIT
    repository:
      owner: {{.Owner}}
      name: homebrew-tap
      branch: main
    directory: Formula
    commit_author:
      name: goreleaserbot
      email: bot@goreleaser.com
    install: |
      bin.install "{{.Name}}"
    test: |
      system "#{bin}/{{.Name}}", "--version"
