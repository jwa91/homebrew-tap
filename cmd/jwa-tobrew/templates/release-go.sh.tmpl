#!/usr/bin/env bash
# Release {{.Name}} via GoReleaser, using the GitHub PAT stored in 1Password.
#
# Usage:
#   ./scripts/release.sh                  # release HEAD's existing tag
#   ./scripts/release.sh 0.5.0            # tag v0.5.0 then release
#
# Prereqs: brewtap, goreleaser, gh, op (1Password CLI), 1Password signed in.

set -euo pipefail

cd "$(dirname "$0")/.."

if [[ "${1:-}" != "" ]]; then
  brewtap release --kind go --version "$1"
else
  brewtap release --kind go
fi
